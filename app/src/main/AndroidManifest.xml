<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Home-screen search over contacts and on-device files. Both are requested at
         runtime the first time a search actually reaches for them, not at install.
         Android 13 replaced the single storage read with per-media-type permissions,
         hence the maxSdkVersion split. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Folders and non-media files (documents, archives, downloads) are invisible to
         MediaStore, so searching them means reading the filesystem directly. Since Android
         11 that needs this special permission, granted from a settings screen rather than a
         runtime dialog. It stays optional: without it, file search falls back to MediaStore
         and finds media only. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.PlainPhone"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PlainPhone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.plainphone.app.onboarding"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".FlaggedAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".FlaggedAppChangeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".HiddenAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".HiddenAppChangeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".WaitTimeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".BudgetTimeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".LockoutTimeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".SettingsGateActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".SettingsWaitTimeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".LockedAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".LockedAppChangeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".PinGateActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".FlaggedGateActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".SettingsPinGateActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".PixelSceneActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".PhotoCropActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".ArtViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".AppAccessActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".SearchSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".WebTargetsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".FontActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".NoteEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".NoteSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".NotePinGateActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".NoteLockChangeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlocksActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockEditActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockStartTimeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockEndTimeActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockAppsActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockDeleteActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockDisableActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".SessionLengthActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockGateActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockOverridePinActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <activity
            android:name=".TimeBlockOverrideActivity"
            android:exported="false"
            android:theme="@style/Theme.PlainPhone" />

        <!-- Hands one searched-for file to a viewer app. Not exported, so nothing can query
             it directly; grantUriPermissions is what lets a single Uri be shared through an
             Intent carrying FLAG_GRANT_READ_URI_PERMISSION, and only that Uri. -->
        <provider
            android:name=".PlainFileProvider"
            android:authorities="com.plainphone.app.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".AppMonitorService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
